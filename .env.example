# Copie para .env e ajuste. O .env nao vai para o git.
SECRET_KEY=troque-por-uma-chave-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Em producao com HTTPS, deixe true (o cookie de sessao so trafega criptografado)
COOKIE_SECURE=false
DATABASE_URL=postgresql://oncopet:oncopet123@localhost:5433/oncopet
MONGODB_URL=mongodb://localhost:27018
MONGODB_DB_NAME=oncopet_exams
# "Esqueci minha senha": endereco do front usado no link do e-mail

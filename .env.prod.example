# Configuracao de producao. O deploy/gerar-env.sh cria o .env.prod com tudo preenchido.
# O .env.prod NAO vai para o git.

# Endereco do site: IP publico com tracos + .sslip.io (ex.: 54-12-3-4.sslip.io)
DOMAIN=54-12-3-4.sslip.io

# Use so letras e numeros (vao dentro de URLs de conexao). Gere com: openssl rand -hex 16
POSTGRES_PASSWORD=troque-esta-senha
MONGO_PASSWORD=troque-esta-senha

# Assina os tokens de login. Gere com: openssl rand -hex 32
SECRET_KEY=troque-esta-chave

ACCESS_TOKEN_EXPIRE_MINUTES=480

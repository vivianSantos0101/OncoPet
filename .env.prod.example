# Configuracao de producao. O deploy/gerar-env.sh cria o .env.prod com tudo preenchido.
# O .env.prod NAO vai para o git.

# Endereco do site: IP publico com tracos + .sslip.io (ex.: 54-12-3-4.sslip.io)
DOMAIN=54-12-3-4.sslip.io

# Use so letras e numeros (vao dentro de URLs de conexao). Gere com: openssl rand -hex 16
POSTGRES_PASSWORD=troque-esta-senha
MONGO_PASSWORD=troque-esta-senha

# Assina os tokens de login. Gere com: openssl rand -hex 32
SECRET_KEY=troque-esta-chave

ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── E-mail ("esqueci minha senha") ───────────────────
# Endereco usado no link do e-mail. Sem esta linha: https:// + DOMAIN
# APP_URL=https://54-12-3-4.sslip.io

# Servidor SMTP. Sem SMTP_HOST, o e-mail nao sai e o link aparece no log do backend.
# Gmail: smtp.gmail.com, porta 587, SMTP_PASSWORD = senha de app (nao a senha da conta).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
